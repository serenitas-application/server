{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "#infrastructure/*": ["./src/infrastructure/*"],
      "#modules/*": ["./src/modules/*"],
      "#common/*": ["./src/common/*"],
      "#static/*": ["./src/static/*"],

    },
    "preserveWatchOutput": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*", "**/*"]
}