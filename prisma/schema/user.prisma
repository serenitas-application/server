model User {
    id         Int      @id @default(autoincrement())
    email      String   @unique
    username   String
    password   String
    createDate DateTime @default(now()) @map("created_date") @db.Timestamptz(6)
    verified   Boolean  @default(false)

    groups           PageGroup[]
    mood             Mood[]
    diaries          Diary[]
    emailVerifyToken EmailVerifyToken[]

    @@map("users")
}
